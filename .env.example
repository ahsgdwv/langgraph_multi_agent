# LLM 配置（OpenAI 兼容接口）
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com

# 流程控制
AUTO_APPROVE_HUMAN=true
USE_SUPERVISOR=true

# 企业化基础配置
DATABASE_URL=sqlite:///data/app.db
CHECKPOINT_BACKEND=sqlite
# POSTGRES_DSN=postgresql://fmcg:change-me@localhost:5432/fmcg
AUTH_MODE=dev
# API_KEYS_JSON={"change-me-key":{"tenant_id":"demo","user_id":"alice","role":"admin"}}
LOG_LEVEL=INFO
LOG_JSON=true
EMBEDDING_PROVIDER=auto

# 网页端口（可选）
GRADIO_PORT=7860

# 演示品牌（可选，留空则使用通用快消文案）
# BRAND_NAME=清泉饮品
# BRAND_REGION=华东区
